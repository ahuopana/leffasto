{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.upcitemdb.com/*"
        },
        {
          "url": "https://api.themoviedb.org/*"
        }
      ]
    }
  ]
}
